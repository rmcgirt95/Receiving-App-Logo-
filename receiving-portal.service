[Unit]
Description=Synoligo Receiving Portal Shortcut
After=network.target

[Service]
Type=simple
User=freezer-monitor
WorkingDirectory=/home/freezer-monitor/Receiving-Portal
ExecStart=/usr/bin/python3 /home/freezer-monitor/Receiving-Portal/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
